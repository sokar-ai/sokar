<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.fuin.sokar</groupId>
        <artifactId>sokar-dist</artifactId>
        <version>0.4.2-SNAPSHOT</version>
    </parent>

    <artifactId>sokar-dist-package-check</artifactId>
    <name>Sokar Package Check</name>
    <description>Sokar - Checking the .deb and the .rpm against each other and against a real install (DIST-PACKAGE-CHECK)</description>

    <!-- Beside the modules whose packages it reads: a regrouping changes the places in Main and meets LayoutTest in
         the same build, and no released tool knows this tree's layout. Run after '-Pnative,dist verify':
         '-pl dist/package-check compile exec:java@package-check'. -->

    <properties>
        <!-- The images the packages are installed in, filtered into images.properties for Main. By digest and by
             their registry's full name: a tag is rebuilt in place, and a short name is resolved by whichever
             registries the machine's podman is configured to ask, so either checks against bytes nobody reviewed.
             The ubuntu pin is moved by the release tooling, as the machines' are; the fedora one by hand, since
             no upstream the release tooling reads answers for registry.fedoraproject.org.
             A Fedora release is taken while it is maintained. Ubuntu 26.04, because the packages need podman 5
             and 24.04 offers 4.9.3, so apt refuses to install them there. -->
        <check.image.ubuntu>docker.io/library/ubuntu:26.04</check.image.ubuntu>
        <check.image.ubuntu.digest>sha256:3595d7fc4286a33fad0fd853a4063e654287a9c3787437d7937c94ca3f7a804e</check.image.ubuntu.digest>
        <check.image.fedora>registry.fedoraproject.org/fedora:44</check.image.fedora>
        <check.image.fedora.digest>sha256:7011f51bd8089d345be42d41f0aa3190d258823528852a5e7ec976fe2fd20f53</check.image.fedora.digest>

        <sokar.release.min-age>3d</sokar.release.min-age>
        <sokar.release.pin.ubuntu-image.label>The ubuntu image the .deb is installed in</sokar.release.pin.ubuntu-image.label>
        <sokar.release.pin.ubuntu-image.property>check.image.ubuntu.digest</sokar.release.pin.ubuntu-image.property>
        <sokar.release.pin.ubuntu-image.upstream>docker-hub https://hub.docker.com/v2/repositories/library/ubuntu/tags/26.04</sokar.release.pin.ubuntu-image.upstream>
    </properties>

    <dependencies>

        <!-- The bill is JSON, and this parser is the tools' own. -->
        <dependency>
            <groupId>org.fuin.sokar</groupId>
            <artifactId>sokar-json</artifactId>
            <version>${sokar.buildtools.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <!-- After -Pnative,dist verify: the two packages against each other, then installed in clean
                         containers. -->
                    <execution>
                        <id>package-check</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>org.fuin.sokar.packagecheck.Main</mainClass>
                            <arguments>
                                <argument>${maven.multiModuleProjectDirectory}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
