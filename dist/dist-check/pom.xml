<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.fuin.sokar</groupId>
        <artifactId>sokar-dist</artifactId>
        <version>0.4.2-SNAPSHOT</version>
    </parent>

    <artifactId>sokar-dist-check</artifactId>
    <name>Sokar Package Checks</name>
    <description>Reads the packages this build wrote and holds them to the version they must carry</description>

    <!-- After both packages and the stub agent's, in the reactor: what it reads must be written first. -->
    <dependencies>
        <dependency>
            <groupId>org.fuin.sokar</groupId>
            <artifactId>sokar-dist-deb</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
        </dependency>
        <dependency>
            <groupId>org.fuin.sokar</groupId>
            <artifactId>sokar-dist-rpm</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Only where packages are built: -Pdist turns it on below. -->
                    <skipTests>true</skipTests>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>dist</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <skipTests>false</skipTests>
                            <systemPropertyVariables>
                                <!-- The raw parts, not sokar.package.version: the check maps them itself, so a
                                     mistake in the mapping is not the answer it is held to. -->
                                <sokar.check.projectVersion>${project.version}</sokar.check.projectVersion>
                                <sokar.check.run>${sokar.snapshot.run}</sokar.check.run>
                                <sokar.check.suffix>${sokar.snapshot.suffix}</sokar.check.suffix>
                                <sokar.check.deb>${project.basedir}/../dist-deb/target</sokar.check.deb>
                                <sokar.check.rpm>${project.basedir}/../dist-rpm/target</sokar.check.rpm>
                                <sokar.check.stub>${project.basedir}/../../agents/stub/target</sokar.check.stub>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                    <!-- The binaries the packages carry need no newer C library or zlib than both declare, and
                         that floor stays within the oldest system supported. -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>check-linkage</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <includeProjectDependencies>false</includeProjectDependencies>
                                    <includePluginDependencies>true</includePluginDependencies>
                                    <executableDependency>
                                        <groupId>org.fuin.sokar</groupId>
                                        <artifactId>sokar-release</artifactId>
                                    </executableDependency>
                                    <commandlineArgs>-classpath %classpath org.fuin.sokar.release.Main check-linkage --declare libc.so.6=GLIBC:${package.glibc.floor} --declare libz.so.1=ZLIB:${package.zlib.floor} --ceiling GLIBC=${package.glibc.ceiling} ${project.basedir}/../../apps/app/target/sokar ${project.basedir}/../../daemon/target/sokard ${project.basedir}/../../agents/stub/target/sokar-agent-stub ${project.basedir}/../../hooks/target/sokar-hook-nft ${project.basedir}/../../hooks/target/sokar-hook-supervisor ${project.basedir}/../../hooks/target/sokar-hook-reader</commandlineArgs>
                                </configuration>
                            </execution>
                        </executions>
                        <dependencies>
                            <dependency>
                                <groupId>org.fuin.sokar</groupId>
                                <artifactId>sokar-release</artifactId>
                                <version>${sokar.buildtools.version}</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
