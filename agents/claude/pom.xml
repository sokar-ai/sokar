<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.fuin.sokar</groupId>
        <artifactId>sokar-agents</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>sokar-agent-claude</artifactId>

    <!-- Deliberately NOT Sokar's version. An agent ships and versions on its own cadence, and
         this is the version its .deb and .rpm carry; Sokar's release line does not appear in
         the artifact at all.

         The Sokar dependencies below resolve through the root dependencyManagement, which pins
         ${sokar.version} rather than ${project.version}. That matters: a parent's
         ${project.version} is interpolated against the module that inherits it, so it would
         resolve to THIS version and find nothing. -->

    <version>1.0.0-SNAPSHOT</version>
    <name>Sokar Agent Claude Code</name>
    <description>Sokar agent for Claude Code</description>

    <properties>
        <!-- Filtered into claude.yaml and the package description; bump it with the digest. -->
        <agent.cli.version>2.1.236</agent.cli.version>
        <!-- This module is an agent, so it packages itself. -->
        <agent.package.skip>false</agent.package.skip>
    </properties>

    <dependencies>

        <!-- compile: the agent API, and nothing else. Never another agent. -->

        <dependency>
            <groupId>org.fuin.sokar</groupId>
            <artifactId>sokar-agent-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.fuin.sokar</groupId>
            <artifactId>sokar-wire</artifactId>
        </dependency>

    </dependencies>

    <profiles>

        <!-- Requires GraalVM as JAVA_HOME. Produces target/sokar-agent-claude, which is installed
             into the agent directory and started by Sokar on demand. Versioned, built and
             delivered independently of the sokar binary. -->

        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>build-sokar-agent-claude</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <configuration>
                                    <imageName>sokar-agent-claude</imageName>
                                    <mainClass>org.fuin.sokar.agent.impl.claude.ClaudeAgent</mainClass>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

    </profiles>

</project>
