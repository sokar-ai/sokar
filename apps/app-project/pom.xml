<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.fuin.sokar</groupId>
        <artifactId>sokar-apps</artifactId>
        <version>0.4.1</version>
    </parent>

    <artifactId>sokar-app-project</artifactId>
    <name>Sokar App - Project, follow and clean-up</name>
    <description>Sokar - the command line's and the daemon's project, follow and clean-up area. Its place among the areas is its dependencies:
        an area that is not one of them cannot be reached from here, and the build says so.</description>

    <dependencies>

        <dependency>
            <groupId>org.fuin.sokar</groupId>
            <artifactId>sokar-app-base</artifactId>
        </dependency>
        <dependency>
            <groupId>org.fuin.sokar</groupId>
            <artifactId>sokar-app-model</artifactId>
        </dependency>
        <dependency>
            <groupId>org.fuin.sokar</groupId>
            <artifactId>sokar-app-agents</artifactId>
        </dependency>
        <dependency>
            <groupId>org.fuin.sokar</groupId>
            <artifactId>sokar-app-messaging</artifactId>
        </dependency>
        <dependency>
            <groupId>org.fuin.sokar</groupId>
            <artifactId>sokar-app-task</artifactId>
        </dependency>
        <dependency>
            <groupId>org.fuin.sokar</groupId>
            <artifactId>sokar-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.fuin.sokar</groupId>
            <artifactId>sokar-wire</artifactId>
        </dependency>
        <dependency>
            <groupId>org.fuin.sokar</groupId>
            <artifactId>sokar-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>org.fuin.sokar</groupId>
            <artifactId>sokar-shield</artifactId>
        </dependency>
        <dependency>
            <groupId>org.fuin.sokar</groupId>
            <artifactId>sokar-clearance</artifactId>
        </dependency>
        <dependency>
            <groupId>org.fuin.sokar</groupId>
            <artifactId>sokar-vault</artifactId>
        </dependency>
        <dependency>
            <groupId>org.fuin.sokar</groupId>
            <artifactId>sokar-gate</artifactId>
        </dependency>
        <dependency>
            <groupId>org.fuin.sokar</groupId>
            <artifactId>sokar-supervisor</artifactId>
        </dependency>
        <dependency>
            <groupId>org.fuin.sokar</groupId>
            <artifactId>sokar-agent-api</artifactId>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli-codegen</artifactId>
            <scope>provided</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Each module with commands generates its own picocli reflection metadata; without it the JVM tests
                 pass and only the native binary fails. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>info.picocli</groupId>
                            <artifactId>picocli-codegen</artifactId>
                            <version>${picocli.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-Aproject=${project.groupId}/${project.artifactId}</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
