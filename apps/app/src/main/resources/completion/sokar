# bash completion for sokar. Generated by nothing: this file is the source.
#
# It asks the program rather than carrying a list, because container and project names change
# while you work. 'sokar __complete' takes the words typed so far, the last one being the partial
# word, and answers one candidate per line. It only ever reads.

_sokar_completions() {
    local IFS=$'\n'
    local candidates
    # ${COMP_WORDS[@]:0:$COMP_CWORD} is everything before the cursor; the partial word is passed
    # explicitly, because COMP_WORDS does not contain it when the cursor sits after a space.
    candidates="$("${COMP_WORDS[0]}" __complete -- "${COMP_WORDS[@]:0:$COMP_CWORD}" \
        "${COMP_WORDS[$COMP_CWORD]}" 2>/dev/null)" || return 0
    COMPREPLY=($(compgen -W "$candidates" -- "${COMP_WORDS[$COMP_CWORD]}"))
    return 0
}

complete -F _sokar_completions sokar
