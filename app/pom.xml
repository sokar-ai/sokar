<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.fuin.sokar</groupId>
        <artifactId>sokar</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>sokar-app</artifactId>
    <name>Sokar App</name>
    <description>Sokar - Orchestration and CLI (APP)</description>

    <dependencies>

        <!-- compile -->

        <dependency>
            <groupId>org.fuin.sokar</groupId>
            <artifactId>sokar-core</artifactId>
        </dependency>

        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>

        <!-- test -->

        <dependency>
            <groupId>org.fuin.sokar</groupId>
            <artifactId>sokar-testing</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- provided: generates the picocli reflection metadata at compile time, so the native
             image needs no hand-written configuration for the command tree. -->

        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli-codegen</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.fuin.sokar</groupId>
            <artifactId>sokar-wire</artifactId>
        </dependency>

        <dependency>
            <groupId>org.fuin.sokar</groupId>
            <artifactId>sokar-runtime</artifactId>
        </dependency>

        <dependency>
            <groupId>org.fuin.sokar</groupId>
            <artifactId>sokar-shield</artifactId>
        </dependency>

        <dependency>
            <groupId>org.fuin.sokar</groupId>
            <artifactId>sokar-clearance</artifactId>
        </dependency>

        <dependency>
            <groupId>org.fuin.sokar</groupId>
            <artifactId>sokar-vault</artifactId>
        </dependency>

        <dependency>
            <groupId>org.fuin.sokar</groupId>
            <artifactId>sokar-gate</artifactId>
        </dependency>

        <dependency>
            <groupId>org.fuin.sokar</groupId>
            <artifactId>sokar-supervisor</artifactId>
        </dependency>

        <dependency>
            <groupId>org.fuin.sokar</groupId>
            <artifactId>sokar-agent-api</artifactId>
        </dependency>

    </dependencies>

    <build>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>

        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>info.picocli</groupId>
                            <artifactId>picocli-codegen</artifactId>
                            <version>${picocli.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-Aproject=${project.groupId}/${project.artifactId}</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

        </plugins>

    </build>

    <profiles>

        <!-- Requires GraalVM as JAVA_HOME. Produces target/sokar, dynamically linked
             against the build host's glibc: this binary uses Panama FFM, and FFM cannot be
             statically linked because Linker.defaultLookup() dlopens libc.so.6 (spike S5). -->

        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>build-sokar</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <configuration>
                                    <imageName>sokar</imageName>
                                    <mainClass>org.fuin.sokar.app.SokarCli</mainClass>
                                    <buildArgs combine.children="append">
                                        <buildArg>--enable-native-access=ALL-UNNAMED</buildArg>
                                    </buildArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

    </profiles>

</project>
