{
  "comment": [
    "dbus-java uses dynamic proxies and instantiates signal classes reflectively, neither of",
    "which native-image can see. Derived from spike S3's agent-generated metadata, with the",
    "probe's interface names replaced by Sokar's own, then verified by running the binary.",
    "This is the only significant reflection surface in the build."
  ],
  "reflection": [
    {
      "type": "com.sun.security.auth.module.UnixSystem",
      "jniAccessible": true,
      "fields": [
        {
          "name": "gid"
        },
        {
          "name": "groups"
        },
        {
          "name": "uid"
        },
        {
          "name": "username"
        }
      ]
    },
    {
      "type": "java.lang.Boolean",
      "jniAccessible": true,
      "methods": [
        {
          "name": "getBoolean",
          "parameterTypes": [
            "java.lang.String"
          ]
        }
      ]
    },
    {
      "type": "org.freedesktop.dbus.connections.base.GlobalHandler"
    },
    {
      "type": "org.freedesktop.dbus.interfaces.DBus$NameAcquired",
      "methods": [
        {
          "name": "<init>",
          "parameterTypes": [
            "java.lang.String",
            "java.lang.String"
          ]
        }
      ]
    },
    {
      "type": "org.freedesktop.dbus.interfaces.Introspectable"
    },
    {
      "type": "org.freedesktop.dbus.interfaces.Peer"
    },
    {
      "type": "org.freedesktop.dbus.interfaces.Properties"
    },
    {
      "type": "org.freedesktop.dbus.transport.jre.NativeTransportProvider"
    },
    {
      "type": "sun.security.provider.NativePRNG",
