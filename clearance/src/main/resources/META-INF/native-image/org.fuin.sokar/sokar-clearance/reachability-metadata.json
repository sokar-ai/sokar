    },
    {
      "type": "org.fuin.sokar.clearance.DesktopPrompt$Notifications$NotificationClosed",
      "methods": [
        {
          "name": "<init>",
          "parameterTypes": [
            "java.lang.String",
            "org.freedesktop.dbus.types.UInt32",
            "org.freedesktop.dbus.types.UInt32"
          ]
        }
      ]
    }
  ],
  "resources": [
