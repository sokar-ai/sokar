          "name": "<init>",
          "parameterTypes": [
            "java.security.SecureRandomParameters"
          ]
        }
      ]
    },
    {
      "type": "sun.security.provider.NativePRNG$NonBlocking",
      "methods": [
        {
          "name": "<init>",
          "parameterTypes": [
            "java.security.SecureRandomParameters"
          ]
        }
      ]
    },
    {
      "type": "sun.text.resources.CollationData"
    },
    {
      "type": {
        "proxy": [
          "org.fuin.sokar.clearance.DesktopPrompt$Notifications"
        ]
      }
    },
    {
