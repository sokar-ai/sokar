[Unit]
Description=Sokar daemon
Documentation=https://github.com/sokar-ai/sokar

[Service]
Type=simple
ExecStart=/usr/bin/sokard
Restart=on-failure
RestartSec=2

# No NoNewPrivileges: the first rootless podman after a boot needs the setuid newuidmap and
# newgidmap. Everything else it uses is what the user already has - it drives podman, git and an
# ssh agent on that user's behalf, so confining it further would only confine the operator.

[Install]
WantedBy=default.target
