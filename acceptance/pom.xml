<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.fuin.sokar</groupId>
        <artifactId>sokar</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>sokar-acceptance</artifactId>
    <name>Sokar Acceptance</name>
    <description>Sokar - What a person does at a terminal, tested on a real machine (TESTING)</description>

    <properties>
        <!-- Nothing here runs without a machine to run it against, so the suite is off unless a
             host is given. Naming one is what turns it on: see the module's README. -->
        <sokar.acceptance.host/>
        <sokar.acceptance.user>claude</sokar.acceptance.user>
        <sokar.acceptance.key>${user.home}/.claude/.ssh/claude_key</sokar.acceptance.key>
        <!-- Whose Sokar to drive. Empty means the user this suite connects as. -->
        <sokar.acceptance.as/>
        <!-- Nothing to publish: this module is a test harness. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
    </properties>

    <dependencies>

        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- The ssh client. Chosen over MINA SSHD for the smaller API around a pty, and over
             'ssh -tt' as a subprocess because window size and pty modes are what several of
             these scenarios are about. -->
        <dependency>
            <groupId>com.hierynomus</groupId>
            <artifactId>sshj</artifactId>
            <version>${sshj.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- The key in use is ed25519, which sshj reads through BouncyCastle. Already managed by
             this build for the vault, so it costs nothing new here. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Failsafe, not surefire: these need a machine, so they are integration tests and
                 they run at 'verify'. A unit test that cannot run without a rented server would
                 make 'mvn test' mean something different in this module than in every other. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${maven-failsafe-plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- Skipped unless a host is named. A suite that fails because nobody gave it
                         a machine is noise in every other build. -->
                    <skipITs>${sokar.acceptance.skip}</skipITs>
                    <systemPropertyVariables>
                        <sokar.acceptance.host>${sokar.acceptance.host}</sokar.acceptance.host>
                        <sokar.acceptance.user>${sokar.acceptance.user}</sokar.acceptance.user>
                        <sokar.acceptance.as>${sokar.acceptance.as}</sokar.acceptance.as>
                        <sokar.acceptance.key>${sokar.acceptance.key}</sokar.acceptance.key>
                        <cucumber.plugin>pretty, html:target/acceptance.html, json:target/acceptance.json, org.fuin.sokar.acceptance.GitHubReport</cucumber.plugin>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>acceptance-off</id>
            <activation>
                <property><name>!sokar.acceptance.host</name></property>
            </activation>
            <properties>
                <sokar.acceptance.skip>true</sokar.acceptance.skip>
            </properties>
        </profile>
        <profile>
            <id>acceptance-on</id>
            <activation>
                <property><name>sokar.acceptance.host</name></property>
            </activation>
            <properties>
                <sokar.acceptance.skip>false</sokar.acceptance.skip>
            </properties>
        </profile>
    </profiles>

</project>
