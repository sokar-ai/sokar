<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.fuin.sokar</groupId>
        <artifactId>sokar</artifactId>
        <version>0.4.1-SNAPSHOT</version>
    </parent>

    <artifactId>sokar-bom</artifactId>
    <packaging>pom</packaging>
    <name>Sokar BOM</name>
    <description>Sokar - The versions a repository that builds against Sokar needs, named once (BOM)</description>

    <!-- Only what crosses the repository boundary. Anything an agent or a suite in another
         repository has to agree with this one about is here; nothing this build uses only for
         itself is. -->
    <dependencyManagement>
        <dependencies>

            <!-- What this repository publishes for others to build against, released together with it - and
                 nothing else: JUnit, the build tools and third-party versions are sokar-parent's. -->
            <dependency>
                <groupId>org.fuin.sokar</groupId>
                <artifactId>sokar-agent-api</artifactId>
                <version>${sokar.version}</version>
            </dependency>
            <dependency>
                <groupId>org.fuin.sokar</groupId>
                <artifactId>sokar-build-api</artifactId>
                <version>${sokar.version}</version>
            </dependency>
            <dependency>
                <groupId>org.fuin.sokar</groupId>
                <artifactId>sokar-wire</artifactId>
                <version>${sokar.version}</version>
            </dependency>
            <dependency>
                <groupId>org.fuin.sokar</groupId>
                <artifactId>sokar-acceptance-kit</artifactId>
                <version>${sokar.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Deployed to Central beside the agent API: a repository that is not this one imports
                     it first and never names a Sokar version, or a JUnit one, again. Opted in on the two
                     plugins rather than by the properties every other published module sets: this pom's
                     properties are published with it, and a repository that took it as its parent then
                     inherited 'publish me'. -->
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <!-- The one org.fuin:pom's release profile runs; without it here, a build without that
                         profile cannot resolve the plugin it manages. -->
                    <version>0.10.0</version>
                    <configuration>
                        <skipPublishing>false</skipPublishing>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <configuration>
                        <skip>false</skip>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- The root flattens in 'oss' mode, which drops dependencyManagement - and a BOM
                 with no dependencyManagement is an empty promise. 'bom' mode keeps it, with the
                 properties above resolved to numbers, which is what an importer should see. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <configuration>
                    <flattenMode>bom</flattenMode>
                    <pomElements>
                        <!-- The root gives every module a dependency, and a BOM has none. The
                             properties stay: flatten writes the versions as the variables they
                             are written with, and an importer resolves them from this POM's own
                             properties - 'interpolate' does not resolve them and 'remove' then
                             leaves a variable nothing can answer, measured. -->
                        <dependencies>remove</dependencies>
                    </pomElements>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
