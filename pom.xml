    <build>

        <pluginManagement>

            <plugins>

                <!-- The FFM check, where a module's ffm-check profile sets sokar.ffm.skip to false, and the
                     CPU check, where a native profile sets sokar.cpu.skip to false. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-help-plugin</artifactId>
                    <version>${maven-help-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${exec-maven-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>ffm-check</id>
                            <phase>prepare-package</phase>
                            <goals>
                                <goal>java</goal>
                            </goals>
                            <configuration>
                                <skip>${sokar.ffm.skip}</skip>
                                <mainClass>org.fuin.sokar.ffmcheck.ForeignRegistrations</mainClass>
                                <includeProjectDependencies>false</includeProjectDependencies>
                                <includePluginDependencies>true</includePluginDependencies>
                                <arguments>
                                    <argument>${project.build.directory}/native/agent-output</argument>
                                    <argument>${project.basedir}/src/main/resources/META-INF/native-image/org.fuin.sokar/${project.artifactId}/reachability-metadata.json</argument>
                                </arguments>
                            </configuration>
                        </execution>
                        <!-- The CPU check: each image asks for exactly x86-64 v1. In package, not verify,
                             because the legs and the snapshot build stop at package; a module declares
                             this plugin after native-maven-plugin, so it runs after the images exist. -->
                        <execution>
                            <id>cpu-check</id>
                            <phase>package</phase>
                            <goals>
                                <goal>java</goal>
                            </goals>
                            <configuration>
                                <skip>${sokar.cpu.skip}</skip>
                                <mainClass>org.fuin.sokar.cpucheck.CpuFloor</mainClass>
                                <includeProjectDependencies>false</includeProjectDependencies>
                                <includePluginDependencies>true</includePluginDependencies>
                                <arguments>
                                    <argument>${project.build.directory}</argument>
                                    <argument>${sokar.cpu.images}</argument>
                                </arguments>
                            </configuration>
                        </execution>
                    </executions>
                    <dependencies>
                        <dependency>
                            <groupId>org.fuin.sokar</groupId>
                            <artifactId>sokar-ffm-check</artifactId>
                            <version>${sokar.buildtools.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>org.fuin.sokar</groupId>
                            <artifactId>sokar-cpu-check</artifactId>
                            <version>${sokar.buildtools.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>

                <!-- A CycloneDX bill for anything published. Managed here, bound only in the
                     modules that publish: a native image is opaque to a scanner and an archive
                     hides what is inside it, so what a dependency graph says at build time is
                     the only thing that can be checked later. -->

                <plugin>
                    <groupId>org.cyclonedx</groupId>
                    <artifactId>cyclonedx-maven-plugin</artifactId>
                    <version>${cyclonedx-maven-plugin.version}</version>
                    <configuration>
                        <projectType>library</projectType>
                        <schemaVersion>1.6</schemaVersion>
                        <outputFormat>json</outputFormat>
                        <outputName>${project.artifactId}-${project.version}-cyclonedx</outputName>
                        <!-- Runtime and compile only. A bill that lists junit tells an operator
                             nothing about what they installed. -->
                        <includeCompileScope>true</includeCompileScope>
                        <includeRuntimeScope>true</includeRuntimeScope>
                        <includeProvidedScope>false</includeProvidedScope>
                        <includeSystemScope>false</includeSystemScope>
                        <includeTestScope>false</includeTestScope>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- Panama downcalls are a restricted operation and will be blocked
                             outright in a future release without this. -->
                        <argLine>@{argLine} --enable-native-access=ALL-UNNAMED</argLine>
                        <!-- A unit test runs what it starts as it is, on every machine: with a
                             systemd user manager, task processes would otherwise go into scopes of
                             their own here and not on a CI runner, and a test would pass on one. -->
                        <environmentVariables>
                            <SOKAR_TASK_SCOPES>off</SOKAR_TASK_SCOPES>
                            <!-- And git as a runner has it: a developer's global configuration signed
                                 every commit a test made, with a key that needs a passphrase, and the
                                 tests failed whenever its agent did not hold it (2026-10-04). -->
                            <GIT_CONFIG_GLOBAL>/dev/null</GIT_CONFIG_GLOBAL>
                            <GIT_CONFIG_NOSYSTEM>1</GIT_CONFIG_NOSYSTEM>
                        </environmentVariables>
                        <!-- And with nothing installed, on every machine: an agent, a filter or a
                             transport the sokar packages put under /usr would otherwise be found by
                             the tests on a developer's machine that has them and not on a runner. -->
                        <systemPropertyVariables>
                            <sokar.packaged.root>${project.build.directory}/no-packages</sokar.packaged.root>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.graalvm.buildtools</groupId>
                    <artifactId>native-maven-plugin</artifactId>
                    <version>${native-maven-plugin.version}</version>
                    <extensions>true</extensions>
                    <configuration>
                        <fallback>false</fallback>
                        <!-- '- -no-fallback' was here and is gone: this GraalVM answers it with
                             "Using a deprecated option - -no-fallback from command line. No effect,
                             no replacement available", so it only put a warning in every build.
                             Fallback images no longer exist, and <fallback>false</fallback> above
                             says what we mean. Noticed by the filter's agent, confirmed in this
                             build's own output on 2026-09-18. -->
                        <buildArgs>
                            <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                            <!-- x86-64 v1, the baseline every x86-64 CPU has. The default is the build
                                 host's generation - v3 on any recent machine - and such a binary will not
                                 start on an older CPU or a VM that hides AVX2. Spelled as the level, not
                                 'compatibility', which is the tool's alias and the tool's to redefine.
                                 sokar-cpu-check holds every image to the exact set. -->
                            <buildArg>-march=x86-64</buildArg>
                        </buildArgs>
                    </configuration>
                </plugin>

            </plugins>

        </pluginManagement>

        <plugins>

            <!-- The package version, computed once for every module.

                 It used to be computed twice, in dist-deb and dist-rpm, and nowhere else - so the
                 binary could not say which build it was. The version command read ${project.version}
                 and answered '0.1.0-SNAPSHOT' for every build there has ever been, and the daemon
                 reported the same string over the wire. An interface therefore could not tell two
                 daemons apart, which is exactly what it needed to do: a test VM sat three weeks
                 behind on 0.1.0~snapshot.9011 and nothing could say so.

                 Here rather than in the dist profile, because the answer has to exist in an
                 ordinary build too - app filters it into sokar-version.properties at
                 process-resources, and validate runs first.

                 Per-module by design: regex-property resolves ${project.version} against the
                 project it runs in. Agent modules are on their own version line and compute
                 'agent.package.version' for themselves; this one is Sokar's. -->

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>${build-helper.version}</version>
                <executions>
                    <execution>
                        <id>package-version</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>regex-property</goal>
                        </goals>
                        <configuration>
                            <!-- '~' sorts below everything in both dpkg and rpm, so
                                 0.1.0~snapshot.N is older than 0.1.0. Left as '-SNAPSHOT' it
                                 sorts ABOVE the release and apt refuses the upgrade. -->
                            <name>sokar.package.version</name>
                            <value>${project.version}</value>
                            <regex>-SNAPSHOT$</regex>
                            <replacement>~snapshot.${sokar.snapshot.run}${sokar.snapshot.suffix}</replacement>
                            <failIfNoMatch>false</failIfNoMatch>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- sokar.version duplicates <version> above, and the duplication is load-bearing:
                 a parent's ${project.version} is interpolated against the module that inherits
                 it, and agent modules are deliberately on their own version line. This turns
                 the two drifting apart into a build failure here, rather than a resolution
                 error three modules later.

                 'inherited' is on the EXECUTION, not the plugin: the fuin parent already
                 declares maven-enforcer-plugin with an inherited Java/Maven version check, and
                 plugin-level inherited would merge into that declaration and suppress it
                 everywhere. In an agent module ${project.version} legitimately differs, so this
                 rule must not run there. -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-sokar-version-property</id>
                        <phase>validate</phase>
                        <inherited>false</inherited>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireProperty>
                                    <property>project.version</property>
                                    <regex>\Q${sokar.version}\E</regex>
                                    <regexMessage>The root &lt;version&gt; and the sokar.version property in pom.xml have drifted apart. Bump both.</regexMessage>
                                </requireProperty>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Resolved versions inline, so the parent and aggregator poms need not be
                 published. In the main build, not a release profile: what is installed is
                 then what is deployed. Pom modules are skipped, so aggregators keep theirs. -->

            <!-- One bill for everything the packages carry. 'inherited' is on the execution:
                 the aggregate goal runs once, at the root, over the whole reactor - a module
                 that publishes on its own gets its own bill from pluginManagement instead. -->

            <plugin>
                <groupId>dev.logchange</groupId>
                <artifactId>logchange-maven-plugin</artifactId>
                <version>${logchange-maven-plugin.version}</version>
                <!-- One changelog for the repository, kept at the root rather than in every module. -->
                <inherited>false</inherited>
                <executions>
                    <execution>
                        <id>logchange-lint</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>lint</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- NullAway makes a broken @NullMarked contract a compile error; main code only, tests pass null on purpose. -->

            <!-- The tooling run by hand or by a workflow, from the root with -N and bound to no phase. Only here: the checks
                 above are inherited, and these must not put an SSH stack on every module's plugin classpath. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <inherited>false</inherited>
                <executions>
                    <!-- The root has no tests and no images. -->
                    <execution>
                        <id>ffm-check</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>cpu-check</id>
                        <phase>none</phase>
                    </execution>
                    <!-- Builds the packages CI would and installs them on the machine SOKAR_VM and SOKAR_VM_KEY name. -->
                    <execution>
                        <id>deploy</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>org.fuin.sokar.machines.Main</mainClass>
                            <includeProjectDependencies>false</includeProjectDependencies>
                            <includePluginDependencies>true</includePluginDependencies>
                            <executableDependency>
                                <groupId>org.fuin.sokar</groupId>
                                <artifactId>sokar-machines</artifactId>
                            </executableDependency>
                            <commandlineArgs>deploy --repo ${maven.multiModuleProjectDirectory} ${deploy.options}</commandlineArgs>
                        </configuration>
                    </execution>
                    <!-- Any other sokar-machines command, in a JVM of its own: it exits with the command's code. -->
                    <execution>
                        <id>machines</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <includeProjectDependencies>false</includeProjectDependencies>
                            <includePluginDependencies>true</includePluginDependencies>
                            <executableDependency>
                                <groupId>org.fuin.sokar</groupId>
                                <artifactId>sokar-machines</artifactId>
                            </executableDependency>
                            <commandlineArgs>-classpath %classpath org.fuin.sokar.machines.Main ${machines.args}</commandlineArgs>
                        </configuration>
                    </execution>
                    <!-- Every workflow step pinned by commit, refused in the build rather than found in review. -->
                    <execution>
                        <id>check-actions</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <includeProjectDependencies>false</includeProjectDependencies>
                            <includePluginDependencies>true</includePluginDependencies>
                            <executableDependency>
                                <groupId>org.fuin.sokar</groupId>
                                <artifactId>sokar-release</artifactId>
                            </executableDependency>
                            <commandlineArgs>-classpath %classpath org.fuin.sokar.release.Main check-actions ${maven.multiModuleProjectDirectory}/.github</commandlineArgs>
                        </configuration>
                    </execution>
                    <!-- The shared blocks of AGENTS.md carry the hash of their text, so a copy edited on its own fails here. -->
                    <execution>
                        <id>check-shared</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <includeProjectDependencies>false</includeProjectDependencies>
                            <includePluginDependencies>true</includePluginDependencies>
                            <executableDependency>
                                <groupId>org.fuin.sokar</groupId>
                                <artifactId>sokar-release</artifactId>
                            </executableDependency>
                            <commandlineArgs>-classpath %classpath org.fuin.sokar.release.Main check-shared ${maven.multiModuleProjectDirectory}/AGENTS.md</commandlineArgs>
                        </configuration>
                    </execution>
                    <!-- A release builds and packages with no snapshot: run on a tag, on the effective pom
                         'help:effective-pom -Doutput=target/effective-pom.xml' wrote for the whole reactor. -->
                    <execution>
                        <id>check-releases</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <includeProjectDependencies>false</includeProjectDependencies>
                            <includePluginDependencies>true</includePluginDependencies>
                            <executableDependency>
                                <groupId>org.fuin.sokar</groupId>
                                <artifactId>sokar-release</artifactId>
                            </executableDependency>
                            <commandlineArgs>-classpath %classpath org.fuin.sokar.release.Main check-releases ${maven.multiModuleProjectDirectory}/target/effective-pom.xml --requires org.fuin.sokar:sokar-release --requires org.fuin.sokar:sokar-machines</commandlineArgs>
                        </configuration>
                    </execution>
                    <!-- The deploy dry run of every push, read: every module through the publishing plugin, and no
                         upload off the machine. Run after the dry run wrote target/deploy-dry-run.log. -->
                    <execution>
                        <id>check-deploy</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <includeProjectDependencies>false</includeProjectDependencies>
                            <includePluginDependencies>true</includePluginDependencies>
                            <executableDependency>
                                <groupId>org.fuin.sokar</groupId>
                                <artifactId>sokar-release</artifactId>
                            </executableDependency>
                            <commandlineArgs>-classpath %classpath org.fuin.sokar.release.Main check-deploy ${maven.multiModuleProjectDirectory}/target/deploy-dry-run.log</commandlineArgs>
                        </configuration>
                    </execution>
                    <!-- No page or file cites an issue in a way that goes stale once the issue is finished and deleted. -->
                    <execution>
                        <id>check-citations</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <includeProjectDependencies>false</includeProjectDependencies>
                            <includePluginDependencies>true</includePluginDependencies>
                            <executableDependency>
                                <groupId>org.fuin.sokar</groupId>
                                <artifactId>sokar-release</artifactId>
                            </executableDependency>
                            <commandlineArgs>-classpath %classpath org.fuin.sokar.release.Main check-citations ${maven.multiModuleProjectDirectory}</commandlineArgs>
                        </configuration>
                    </execution>
                    <!-- Every module has a README.md beside its pom.xml, linking its submodules. -->
                    <execution>
                        <id>check-readmes</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <includeProjectDependencies>false</includeProjectDependencies>
                            <includePluginDependencies>true</includePluginDependencies>
                            <executableDependency>
                                <groupId>org.fuin.sokar</groupId>
                                <artifactId>sokar-release</artifactId>
                            </executableDependency>
                            <commandlineArgs>-classpath %classpath org.fuin.sokar.release.Main check-readmes ${maven.multiModuleProjectDirectory}</commandlineArgs>
                        </configuration>
                    </execution>
                    <!-- Every page of doc/ is in mkdocs.yml's navigation once, and every link on it can be followed on the site. -->
                    <execution>
                        <id>check-doc-site</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <includeProjectDependencies>false</includeProjectDependencies>
                            <includePluginDependencies>true</includePluginDependencies>
                            <executableDependency>
                                <groupId>org.fuin.sokar</groupId>
                                <artifactId>sokar-release</artifactId>
                            </executableDependency>
                            <commandlineArgs>-classpath %classpath org.fuin.sokar.release.Main check-doc-site ${maven.multiModuleProjectDirectory}/doc ${maven.multiModuleProjectDirectory}/mkdocs.yml</commandlineArgs>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>org.fuin.sokar</groupId>
                        <artifactId>sokar-machines</artifactId>
                        <version>${sokar.buildtools.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.fuin.sokar</groupId>
                        <artifactId>sokar-release</artifactId>
                        <version>${sokar.buildtools.version}</version>
                    </dependency>
                </dependencies>
            </plugin>

            <!-- Every module flattened as sokar-parent manages it, so a published pom names no parent. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>

        </plugins>

    </build>

    <dependencies>

        <!-- compile -->

        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>

        <!-- test -->

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <profiles>
        <profile>
            <!-- Not a CI build. Keyed on the same signal 'org.fuin.sokar.machines' uses to tell
                 one from the other, so the two cannot come to disagree about what local means. -->
            <id>local-package</id>
            <activation>
                <property>
                    <name>!env.GITHUB_RUN_ID</name>
                </property>
            </activation>
            <properties>
                <sokar.snapshot.suffix>+local.${maven.build.timestamp}</sokar.snapshot.suffix>
            </properties>
        </profile>
        <profile>
            <!-- A change to documents or issues: only the tests that read them, tagged so. -->
            <id>documents</id>
            <properties>
                <groups>documents</groups>
            </properties>
        </profile>
    </profiles>

</project>
