<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.fuin</groupId>
        <artifactId>pom</artifactId>
        <version>2.0.2</version>
        <relativePath/>
    </parent>

    <groupId>org.fuin.sokar</groupId>
    <artifactId>sokar</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <description>Sandboxing AI agents in YOLO mode using Podman and Java/GraalVM (PARENT)</description>
    <url>https://github.com/fuinorg/sokar/</url>

    <scm>
        <url>https://github.com/fuinorg/sokar/</url>
        <connection>scm:git:git://github.com/fuinorg/sokar.git</connection>
        <developerConnection>scm:git:git@github.com:fuinorg/sokar.git</developerConnection>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/fuinorg/sokar/issues</url>
    </issueManagement>

    <properties>
        <!-- Panama FFM is only stable from 22 on, and native-image is built with GraalVM 25. -->
        <java.release.version>25</java.release.version>
        <!-- Sokar's own release line. Every internal module except an agent is on it.
             A literal, deliberately: writing ${project.version} here would reintroduce
             the very bug this exists to avoid. Maven assembles inheritance BEFORE it
             interpolates, so a parent's ${project.version} is evaluated against the
             module that inherits it - and an agent module is on a different version.
             Kept equal to <version> above by maven-enforcer-plugin below. -->
        <sokar.version>0.1.0-SNAPSHOT</sokar.version>
        <fuin-bom.version>1.0.2</fuin-bom.version>
        <native-maven-plugin.version>1.1.11</native-maven-plugin.version>
        <picocli.version>4.7.7</picocli.version>
        <snakeyaml.version>2.7</snakeyaml.version>
        <dbus-java.version>5.2.0</dbus-java.version>
        <bouncycastle.version>1.85.2</bouncycastle.version>
        <!-- musl cross-toolchain used for the statically linked hook binaries.
             Install with ./buildtools/install-musl.sh, or override on the command line. -->
        <musl.home>${user.home}/.local/opt/x86_64-linux-musl-native</musl.home>
        <musl.gcc>${musl.home}/bin/x86_64-linux-musl-gcc</musl.gcc>
        <!-- Late-replaced by surefire. Declared empty so '@{argLine}' resolves when JaCoCo,
             which normally sets this property, is not active. -->
        <argLine/>
    </properties>

    <modules>
        <module>wire</module>
        <module>core</module>
        <module>runtime</module>
        <module>shield</module>
        <module>clearance</module>
        <module>vault</module>
        <module>gate</module>
        <module>supervisor</module>
        <module>agents</module>
        <module>app</module>
        <module>daemon</module>
        <module>hooks</module>
        <module>dist-deb</module>
        <module>dist-rpm</module>
    </modules>

    <dependencyManagement>

        <dependencies>

            <!-- Bill of Materials (aligned with Quarkus and Spring Boot BOMs).
                 Also pins Byte Buddy to 1.17.8, which is required on JDK 25:
                 earlier versions reject class-file major version 69. -->

            <dependency>
                <groupId>org.fuin</groupId>
                <artifactId>bom</artifactId>
                <version>${fuin-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Third party not covered by the BOM -->

            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${picocli.version}</version>
            </dependency>

            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli-codegen</artifactId>
                <version>${picocli.version}</version>
            </dependency>

            <dependency>
                <groupId>org.yaml</groupId>
                <artifactId>snakeyaml</artifactId>
                <version>${snakeyaml.version}</version>
            </dependency>

            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>

            <dependency>
                <groupId>com.github.hypfvieh</groupId>
                <artifactId>dbus-java-core</artifactId>
                <version>${dbus-java.version}</version>
            </dependency>

            <dependency>
                <groupId>com.github.hypfvieh</groupId>
                <artifactId>dbus-java-transport-native-unixsocket</artifactId>
                <version>${dbus-java.version}</version>
            </dependency>

            <!-- Modules -->

            <dependency>
                <groupId>org.fuin.sokar</groupId>
                <artifactId>sokar-wire</artifactId>
                <version>${sokar.version}</version>
            </dependency>

            <dependency>
                <groupId>org.fuin.sokar</groupId>
                <artifactId>sokar-core</artifactId>
                <version>${sokar.version}</version>
            </dependency>

            <dependency>
                <groupId>org.fuin.sokar</groupId>
                <artifactId>sokar-core</artifactId>
                <version>${sokar.version}</version>
                <type>test-jar</type>
                <scope>test</scope>
            </dependency>

            <dependency>
                <groupId>org.fuin.sokar</groupId>
                <artifactId>sokar-runtime</artifactId>
                <version>${sokar.version}</version>
            </dependency>

            <dependency>
                <groupId>org.fuin.sokar</groupId>
                <artifactId>sokar-shield</artifactId>
                <version>${sokar.version}</version>
            </dependency>

            <dependency>
                <groupId>org.fuin.sokar</groupId>
                <artifactId>sokar-clearance</artifactId>
                <version>${sokar.version}</version>
            </dependency>

            <dependency>
                <groupId>org.fuin.sokar</groupId>
                <artifactId>sokar-vault</artifactId>
                <version>${sokar.version}</version>
            </dependency>

            <dependency>
                <groupId>org.fuin.sokar</groupId>
                <artifactId>sokar-gate</artifactId>
                <version>${sokar.version}</version>
            </dependency>

            <dependency>
                <groupId>org.fuin.sokar</groupId>
                <artifactId>sokar-supervisor</artifactId>
                <version>${sokar.version}</version>
            </dependency>

            <dependency>
                <groupId>org.fuin.sokar</groupId>
                <artifactId>sokar-agent-api</artifactId>
                <version>${sokar.version}</version>
            </dependency>

            <dependency>
                <groupId>org.fuin.sokar</groupId>
                <artifactId>sokar-app</artifactId>
                <version>${sokar.version}</version>
            </dependency>

            <dependency>
                <groupId>org.fuin.sokar</groupId>
                <artifactId>sokard</artifactId>
                <version>${sokar.version}</version>
            </dependency>

            <dependency>
                <groupId>org.fuin.sokar</groupId>
                <artifactId>sokar-hooks</artifactId>
                <version>${sokar.version}</version>
            </dependency>

            <dependency>
                <groupId>org.fuin.sokar</groupId>
                <artifactId>sokar-dist-deb</artifactId>
                <version>${sokar.version}</version>
            </dependency>

            <dependency>
                <groupId>org.fuin.sokar</groupId>
                <artifactId>sokar-dist-rpm</artifactId>
                <version>${sokar.version}</version>
            </dependency>

        </dependencies>

    </dependencyManagement>

    <build>

        <pluginManagement>

            <plugins>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- Panama downcalls are a restricted operation and will be blocked
                             outright in a future release without this. -->
                        <argLine>@{argLine} --enable-native-access=ALL-UNNAMED</argLine>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.graalvm.buildtools</groupId>
                    <artifactId>native-maven-plugin</artifactId>
                    <version>${native-maven-plugin.version}</version>
                    <extensions>true</extensions>
                    <configuration>
                        <fallback>false</fallback>
                        <buildArgs>
                            <buildArg>--no-fallback</buildArg>
                            <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                        </buildArgs>
                    </configuration>
                </plugin>

            </plugins>

        </pluginManagement>

        <plugins>

            <!-- sokar.version duplicates <version> above, and the duplication is load-bearing:
                 a parent's ${project.version} is interpolated against the module that inherits
                 it, and agent modules are deliberately on their own version line. This turns
                 the two drifting apart into a build failure here, rather than a resolution
                 error three modules later.

                 'inherited' is on the EXECUTION, not the plugin: the fuin parent already
                 declares maven-enforcer-plugin with an inherited Java/Maven version check, and
                 plugin-level inherited would merge into that declaration and suppress it
                 everywhere. In an agent module ${project.version} legitimately differs, so this
                 rule must not run there. -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-sokar-version-property</id>
                        <phase>validate</phase>
                        <inherited>false</inherited>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireProperty>
                                    <property>project.version</property>
                                    <regex>\Q${sokar.version}\E</regex>
                                    <regexMessage>The root &lt;version&gt; and the sokar.version property in pom.xml have drifted apart. Bump both.</regexMessage>
                                </requireProperty>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>

    </build>

    <dependencies>

        <!-- compile -->

        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>

        <!-- test -->

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
