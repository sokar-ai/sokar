         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.fuin.sokar</groupId>
        <artifactId>sokar-parent</artifactId>
        <version>0.1.2</version>
        <relativePath/>
    </parent>

    <groupId>org.fuin.sokar</groupId>
    <artifactId>sokar</artifactId>
    <version>0.4.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Sokar</name>
    <description>Sandboxing AI agents in YOLO mode using Podman and Java/GraalVM (PARENT)</description>

    <!-- Without the inherit.append.path attributes Maven appends each child's artifactId,
         so a module would advertise .../sokar-agents/sokar-agent-api/ in its published pom -
         a path that does not exist. One repository, one url. The project one belongs on
         <project> and the scm ones on <scm>: they are fields of different model objects. -->

    <url>https://github.com/sokar-ai/sokar/</url>

    <scm child.scm.url.inherit.append.path="false"
         child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false">
        <url>https://github.com/sokar-ai/sokar/</url>
        <connection>scm:git:git://github.com/sokar-ai/sokar.git</connection>
        <developerConnection>scm:git:git@github.com:sokar-ai/sokar.git</developerConnection>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/sokar-ai/sokar/issues</url>
    </issueManagement>

    <properties>

        <!-- Nothing is published unless a module opts in, as sokar-parent sets it. Sokar ships as binaries and
             packages; the only artifacts anyone resolves from Maven are the agent API and what it drags in, so
             every other module would be publishing an internal for people to depend on. The Java release, the build
             tools' version and the plugin and library versions every Sokar repository shares come from there too. -->

        <!-- Sokar's own release line. Every internal module except an agent is on it.
             A literal, deliberately: writing ${project.version} here would reintroduce
             the very bug this exists to avoid. Maven assembles inheritance BEFORE it
             interpolates, so a parent's ${project.version} is evaluated against the
             module that inherits it - and an agent module is on a different version.
             Kept equal to <version> above by maven-enforcer-plugin below. -->
        <sokar.version>0.4.1-SNAPSHOT</sokar.version>
        <!-- What distinguishes one snapshot package from the next.
             Without it every build of main produced 0.1.0~SNAPSHOT, which is the SAME version -
             so 'apt upgrade' saw nothing to do and somebody who installed yesterday stayed on it
             until they purged. A repository literally called 'snapshots' whose packages never
             update. CI passes the run number; a local build is 0, which sorts below every CI
             build and above the old flat ~SNAPSHOT, so an existing install upgrades cleanly.
             Verified against dpkg and rpm themselves, including 9 < 10, which is a numeric
             comparison in both and not a lexical one. -->
        <sokar.snapshot.run>0</sokar.snapshot.run>
        <!-- The command line 'exec:exec@machines' gives sokar-machines, such as 'jdk' or 'sweep'. -->
        <machines.args></machines.args>
        <!-- Options for exec:java@deploy, such as the one that skips the build. -->
        <deploy.options></deploy.options>
        <!-- Appended to a package version when this is NOT a CI build. Empty here; the
             'local-package' profile at the end of this file sets it.

             Why it exists: the run number cannot say where a package came from, and a local
             build that wants to replace a published one has to claim a HIGHER number to be
             installable at all. That number then outranks every future CI build, so apt and dnf
             refuse to upgrade the machine ever again - silently, because refusing is the correct
             answer to the question they were asked. Measured on a test VM carrying
             0.1.0~snapshot.9011 against a repository at 0.1.0~snapshot.99: three weeks behind and
             reporting nothing to do.

             '+local.<stamp>' sorts ABOVE the run it names and BELOW the next one, so a local
             package replaces the published build it was made from and the next CI build takes the
             machine back. Verified against dpkg itself, in dist/package-check. -->
        <sokar.snapshot.suffix></sokar.snapshot.suffix>
        <!-- The FFM check runs only in a module whose ffm-check profile turns it on. -->
        <sokar.ffm.skip>true</sokar.ffm.skip>
        <!-- The CPU check runs only in a native profile, which names its images here and turns it on. -->
        <sokar.cpu.skip>true</sokar.cpu.skip>
        <sokar.cpu.images></sokar.cpu.images>
        <picocli.version>4.7.7</picocli.version>
        <!-- picocli injects these fields, so NullAway takes them as initialised; added to sokar-parent's NullAway. -->
        <nullaway.args>-XepOpt:NullAway:ExcludedFieldAnnotations=picocli.CommandLine.Option,picocli.CommandLine.Parameters,picocli.CommandLine.Spec,picocli.CommandLine.ParentCommand,picocli.CommandLine.Mixin</nullaway.args>
        <!-- A pure-Java zstd decoder, so the broker can read a compressed request it must check for a token grant;
             an agent compresses its requests with zstd, and the JDK has no codec for it. -->
        <aircompressor.version>3.10</aircompressor.version>
        <dbus-java.version>5.2.0</dbus-java.version>
        <!-- musl cross-toolchain used for the statically linked hook binaries.
             Install with the build tools' 'musl' command (doc/build.md), or override on the command line. -->
        <musl.home>${user.home}/.local/opt/x86_64-linux-musl-native</musl.home>
        <musl.gcc>${musl.home}/bin/x86_64-linux-musl-gcc</musl.gcc>
        <!-- Late-replaced by surefire. Declared empty so '@{argLine}' resolves when JaCoCo,
             which normally sets this property, is not active. -->
        <argLine/>
    </properties>

