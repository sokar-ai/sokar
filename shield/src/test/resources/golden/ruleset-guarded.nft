# Generated by Sokar for security class 'guarded'. Do not edit.
# Loaded inside the container's network namespace by the nft hook.

table inet sokar {

    set allowed_v4 {
        type ipv4_addr
        flags interval
        elements = { 140.82.112.0/20 }
    }

    set allowed_v6 {
        type ipv6_addr
        flags interval
        elements = { 2606:50c0::/32 }
    }

    chain output {
        type filter hook output priority filter; policy drop;

        # A reply to something the container already sent is not a new decision.
        ct state established,related accept

        # Loopback is inside the namespace, so this reaches nothing outside it.
        oif "lo" accept

        # DNS goes to the resolver Sokar runs, and nowhere else.
        ip daddr 10.89.0.1 udp dport 53 accept
        ip daddr 10.89.0.1 tcp dport 53 accept

        ip daddr @allowed_v4 accept
        ip6 daddr @allowed_v6 accept

        # Everything that reaches this point is dropped by the chain policy.
        # It is logged first, which is what the clearance prompt is built on.
        log prefix "sokar-drop " group 1
    }
}
