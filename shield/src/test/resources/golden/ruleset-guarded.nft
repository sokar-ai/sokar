# Generated by Sokar for security class 'guarded'. Do not edit.
# Loaded inside the container's network namespace by the nft hook.

table inet sokar {

    set allowed_v4 {
        type ipv4_addr
        flags interval
        elements = { 140.82.112.0/20 }
    }

    set allowed_v6 {
        type ipv6_addr
        flags interval
        elements = { 2606:50c0::/32 }
    }

    set allowed_ports {
        type inet_service
        elements = { 80, 443 }
    }

    chain output {
        type filter hook output priority filter; policy drop;

        # A reply to something the container already sent is not a new decision.
        ct state established,related accept

        # Loopback is inside the namespace, so this reaches nothing outside it.
        oif "lo" accept

        # The upstream resolver, for Sokar's resolver alone: it runs in this
        # namespace as its root, the agent does not. Matched on the address
        # only, every process here could ask the upstream itself, and data
        # left in query names with no prompt and no log line.
        ip daddr 10.89.0.1 meta skuid 0 udp dport 53 accept
        ip daddr 10.89.0.1 meta skuid 0 tcp dport 53 accept

        # Web ports only. The resolver and the clearance path both add a
        # HOST here and neither can name a port, so accepting every port
        # would grant more than either of them meant - git over ssh above
        # all, which pushes past the gate. No udp: a client that cannot
        # reach HTTP/3 falls back to TCP.
        ip daddr @allowed_v4 tcp dport @allowed_ports accept
        ip6 daddr @allowed_v6 tcp dport @allowed_ports accept

        # Everything that reaches this point is dropped by the chain policy.
        # It is logged first, which is what the clearance prompt is built on.
        log prefix "sokar-drop " group 1
    }
}
